{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "/opt/anaconda3/envs/llms/bin/python"
        },
        {
            "name": "Python: Current File (External Terminal)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "externalTerminal",
            "justMyCode": true,
            "python": "/opt/anaconda3/envs/llms/bin/python"
        },
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${workspaceFolder}"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "python": "/opt/anaconda3/envs/llms/bin/python"
        }
    ]
}
